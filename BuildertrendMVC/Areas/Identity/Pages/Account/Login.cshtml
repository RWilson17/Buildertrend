
@page
@model BuildertrendMVC.Areas.Identity.Pages.Account.LoginModel



<div class="login-animated-bg"></div>
<div class="login-card login-glass shadow-xxl border-0">
    <div class="text-center mb-4">
        <img src="~/Images/Logo.png" alt="Logo" style="width:90px;height:90px;object-fit:contain;filter:drop-shadow(0 4px 18px #6f42c155);margin-bottom:1.2rem;">
        <h2 class="fw-bold mb-1" style="letter-spacing:1.5px;color:#59359c;font-family:'Segoe UI',sans-serif;">Buildertrend</h2>
        <div class="text-muted mb-3" style="font-size:1.15rem;letter-spacing:0.5px;">Acceso al sistema</div>
    </div>
    <form method="post" class="needs-validation" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="input-group mb-3 login-input-group">
            <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
            <input asp-for="Input.Email" class="form-control login-input" autocomplete="username" aria-required="true" placeholder="Correo electrónico" />
        </div>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
        <div class="input-group mb-3 login-input-group">
            <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
            <input asp-for="Input.Password" class="form-control login-input" autocomplete="current-password" aria-required="true" placeholder="Contraseña" type="password" />
        </div>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
        <div class="form-check mb-3">
            <input asp-for="Input.RememberMe" class="form-check-input" />
            <label asp-for="Input.RememberMe" class="form-check-label">Recordarme</label>
        </div>
        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-gradient mb-2 shadow">Iniciar sesión</button>
        <div class="d-flex justify-content-between flex-wrap gap-2 mt-2">
            <a id="forgot-password" href="/Identity/Account/ForgotPassword" class="small"><i class="bi bi-question-circle me-1"></i>¿Olvidaste tu contraseña?</a>
            <a href="/Identity/Account/Register?returnUrl=@Model.ReturnUrl" class="small"><i class="bi bi-person-plus me-1"></i>Registrarse</a>
        </div>
        <div class="text-center mt-2">
            <a id="resend-confirmation" href="/Identity/Account/ResendEmailConfirmation" class="small"><i class="bi bi-envelope-arrow-up me-1"></i>Reenviar confirmación</a>
        </div>
        <div class="separator my-4"><span>o accede con</span></div>
    </form>
</div>

@* Fondo glassmorphism y estilos extra *@
<style>
body {
    font-family: 'Segoe UI', Arial, sans-serif;
}
.login-animated-bg {
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background: linear-gradient(120deg, #6f42c1 0%, #0d6efd 100%);
    background-size: 200% 200%;
    animation: gradientMove 8s ease-in-out infinite;
    z-index: 0;
    filter: blur(3px) brightness(1.08);
    opacity: 0.92;
}
@@keyframes gradientMove {
    0% {background-position: 0% 50%;}
    50% {background-position: 100% 50%;}
    100% {background-position: 0% 50%;}
}
.login-glass {
    background: rgba(255,255,255,0.90);
    box-shadow: 0 12px 40px 0 #6f42c133, 0 2px 8px #0d6efd22;
    border-radius: 1.7rem;
    backdrop-filter: blur(10px) saturate(1.3);
    border: 1.5px solid #e0e0e0;
    position: relative;
    z-index: 2;
    padding: 2.5rem 2.2rem 2.2rem 2.2rem;
    max-width: 410px;
    margin: 5vh auto 0 auto;
}
.login-card input.form-control.login-input {
    font-size: 1.13rem;
    padding: 0.85rem 1.1rem;
    border-radius: 0.85rem;
    border: 1.5px solid #d1d9e6;
    background: #f8faff;
    box-shadow: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.login-card input.form-control.login-input:focus {
    border-color: #6f42c1;
    box-shadow: 0 0 0 2px #6f42c133;
    background: #fff;
}
.login-card .input-group-text {
    border-radius: 0.85rem 0 0 0.85rem;
    border: 1.5px solid #d1d9e6;
    border-right: 0;
    background: #f8faff;
    color: #6f42c1;
    font-size: 1.2rem;
}
.login-card .form-check-input:checked {
    background-color: #0d6efd;
    border-color: #0d6efd;
}
.btn-gradient {
    background: linear-gradient(90deg,#0d6efd 60%,#6f42c1 100%);
    border: none;
    color: #fff;
    font-weight: 600;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 12px #0d6efd33;
    transition: background 0.3s, box-shadow 0.2s, transform 0.1s;
}
.btn-gradient:hover, .btn-gradient:focus {
    background: linear-gradient(90deg,#6f42c1 60%,#0d6efd 100%);
    box-shadow: 0 4px 18px #6f42c155;
    transform: translateY(-2px) scale(1.03);
}
.login-card .links a, .login-card .small {
    color: #6f42c1;
    text-decoration: none;
    transition: color 0.2s;
}
.login-card .links a:hover, .login-card .small:hover {
    color: #0d6efd;
    text-decoration: underline;
}
.login-card .text-danger {
    font-size: 0.97rem;
}
.separator {
    display: flex;
    align-items: center;
    text-align: center;
    color: #b3b3b3;
    font-size: 1.05rem;
    margin: 2.2rem 0 1.2rem 0;
    letter-spacing: 0.5px;
}
.separator::before, .separator::after {
    content: '';
    flex: 1;
    border-bottom: 1.5px solid #e0e0e0;
    margin: 0 0.7rem;
}
@@media (max-width: 600px) {
    .login-glass {
        padding: 1.2rem 0.5rem;
        border-radius: 1.1rem;
        max-width: 98vw;
    }
    .login-card input.form-control.login-input {
        font-size: 1rem;
        padding: 0.7rem 0.7rem;
    }
}
</style>
@if ((Model.ExternalLogins?.Count ?? 0) > 0)
{
    <div class="login-card mt-4">
        <div class="text-center mb-2 text-muted">O accede con</div>
        <form id="external-account" action="/Identity/Account/ExternalLogin?returnUrl=@(Model.ReturnUrl ?? "")" method="post" class="d-flex flex-column gap-2">
            @foreach (var provider in Model.ExternalLogins!)
            {
                <button type="submit" class="btn btn-outline-primary" name="provider" value="@provider.Name" title="Iniciar sesión con @provider.DisplayName">
                    <i class="bi bi-box-arrow-in-right me-2"></i>@provider.DisplayName
                </button>
            }
        </form>
    </div>
}
