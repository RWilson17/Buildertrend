@model BuildertrendMVC.Models.Quote
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Cotización @Model.QuoteNumber</title>
    <style>
        body { font-family: Arial, sans-serif; }
        .header { background: #f5f5f5; padding: 10px; }
        .title { font-size: 2em; margin-bottom: 0; }
        .info { margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th, td { border: 1px solid #ccc; padding: 8px; }
        th { background: #eee; }
        .totals { font-weight: bold; }
    </style>
</head>
<body>
    <div class="header">
        <div class="title">Cotización @Model.QuoteNumber</div>
        <div class="info">
            <b>Estado:</b> @Model.Estado<br />
            <b>Fecha:</b> @Model.DateCreated.ToString("dd/MM/yyyy")
        </div>
    </div>
    <h3>Partidas</h3>
    <table>
        <thead>
            <tr>
                <th>Cost Code</th>
                <th>Title</th>
                <th>Description</th>
                <th>Qty</th>
                <th>Unit Cost</th>
                <th>Total Cost</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items) {
            <tr>
                <td>@item.CostCode</td>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>@item.Qty</td>
                <td>@item.UnitCost.ToString("C2")</td>
                <td>@item.TotalCost.ToString("C2")</td>
            </tr>
        }
        </tbody>
    </table>
    <div class="totals">
        Total cotización: $@(Model.Items?.Sum(i => i.TotalCost).ToString("N2") ?? "0.00")
    </div>
</body>
</html>
