@model BuildertrendMVC.Models.Client
@{
    ViewData["Title"] = "Eliminar Cliente";
}
<h2 class="mb-4 text-danger"><i class="bi bi-trash"></i> Eliminar Cliente</h2>
<div class="alert alert-warning">¿Estás seguro que deseas eliminar este cliente?</div>
<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>
    <dt class="col-sm-2">Empresa</dt>
    <dd class="col-sm-10">@Model.Empresa</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Teléfono</dt>
    <dd class="col-sm-10">@Model.Telefono</dd>
    <dt class="col-sm-2">Dirección</dt>
    <dd class="col-sm-10">@Model.Direccion</dd>
</dl>
<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
