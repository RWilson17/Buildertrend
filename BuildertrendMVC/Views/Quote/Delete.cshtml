@model BuildertrendMVC.Models.Quote
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Eliminar Cotización";
}
<h2>Eliminar Cotización</h2>
<div class="alert alert-danger">¿Estás seguro de que deseas eliminar esta cotización?</div>
<dl class="row">
            <dt class="col-sm-3">Sales Tax Amount</dt>
            <dd class="col-sm-9">@GetCurrencySymbol(ViewBag.Currency)@FormatAmount(Model.SalesTaxAmount, ViewBag.Currency, ViewBag.Language)</dd>
        <dt class="col-sm-3">Sales Tax</dt>
        <dd class="col-sm-9">
            @{
                decimal stVal;
                if (decimal.TryParse(Model.SalesTax?.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out stVal))
                {
                    @stVal.ToString("P2")
                }
                else
                {
                    @Model.SalesTax
                }
            }
        </dd>
    <dt class="col-sm-3">Partidas</dt>
    <dd class="col-sm-9">
        @if (Model.Items != null && Model.Items.Any())
        {
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>@Localizer["CostCode"]</th>
                        <th>@Localizer["Title"]</th>
                        <th>@Localizer["Description"]</th>
                        <th>@Localizer["Qty"]</th>
                        <th>@Localizer["UnitCost"]</th>
                        <th>@Localizer["MarginPercent"]</th>
                        <th>@Localizer["CustomerCost"]</th>
                        <th>@Localizer["TotalCost"]</th>
                        <th>@Localizer["CostType"]</th>
                        <th>@Localizer["MarkupPercent"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.CostCode</td>
                        <td>@item.Title</td>
                        <td>@item.Description</td>
                        <td>@item.Qty</td>
                        <td>@GetCurrencySymbol(ViewBag.Currency)@FormatAmount(item.UnitCost, ViewBag.Currency, ViewBag.Language)</td>
                        <td>@FormatAmount(item.Margin * 100, ViewBag.Currency, ViewBag.Language)</td>
                        <td>@GetCurrencySymbol(ViewBag.Currency)@FormatAmount(item.CustomerCost, ViewBag.Currency, ViewBag.Language)</td>
                        <td>@GetCurrencySymbol(ViewBag.Currency)@FormatAmount(item.TotalCost, ViewBag.Currency, ViewBag.Language)</td>
                        @functions {
                            public static string GetCurrencySymbol(string currency)
                            {
                                return currency switch
                                {
                                    "USD" => "$",
                                    "EUR" => "€",
                                    "MXN" => "$MXN ",
                                    "CLP" => "$CLP ",
                                    "ARS" => "$ARS ",
                                    _ => "$"
                                };
                            }
                            public static string FormatAmount(decimal amount, string currency, string language)
                            {
                                var culture = (currency, language) switch
                                {
                                    ("USD", "en") => "en-US",
                                    ("USD", _) => "es-MX",
                                    ("EUR", _) => "es-ES",
                                    ("MXN", _) => "es-MX",
                                    ("CLP", _) => "es-CL",
                                    ("ARS", _) => "es-AR",
                                    _ => "es-MX"
                                };
                                return amount.ToString("N2", new System.Globalization.CultureInfo(culture));
                            }
                        }
                        <td>@item.CostType</td>
                        <td>@item.MarkupPercentage</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <span class="text-muted">(Sin partidas)</span>
        }
    </dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-secondary" href="/Quote">Cancelar</a>
</form>
