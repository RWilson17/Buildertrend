@model BuildertrendMVC.Models.Quote
@{
    ViewData["Title"] = $"Detalle Cotización {Model.QuoteNumber}";
}
<h2>Detalle Cotización <span class="badge bg-primary">@Model.QuoteNumber</span></h2>

@if (Model.Client != null)
{
    <div class="alert alert-secondary mb-3">
        <strong>Cliente:</strong> @Model.Client.Nombre (@Model.Client.Empresa)<br />
        <strong>Email:</strong> @Model.Client.Email<br />
        <strong>Teléfono:</strong> @Model.Client.Telefono<br />
        <strong>Dirección:</strong> @Model.Client.Direccion
    </div>
}
<form method="get" asp-action="Exportar" asp-route-id="@Model.Id" class="mb-3" target="_blank">
    <div class="input-group" style="max-width:350px;">
        <select name="plantilla" class="form-select">
            <option value="PlantillaClasica">Plantilla Clásica</option>
            <option value="PlantillaModerna">Plantilla Moderna</option>
        </select>
        <button type="submit" class="btn btn-outline-primary">Exportar PDF</button>
    </div>
</form>
<dl class="row">
    <dt class="col-sm-3">Folio</dt>
    <dd class="col-sm-9">@Model.QuoteNumber</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Estado</span></dd>
    <dt class="col-sm-3">Sales Tax</dt>
    <dd class="col-sm-9">
        @{
            decimal stVal;
            if (decimal.TryParse(Model.SalesTax?.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out stVal))
            {
                @stVal.ToString("P2")
            }
            else
            {
                @Model.SalesTax
            }
        }
    </dd>
    <dt class="col-sm-3">Sales Tax Amount</dt>
    <dd class="col-sm-9">$@Model.SalesTaxAmount.ToString("N2").Replace('.', ',')</dd>
    <dt class="col-sm-3">Total Cotización</dt>
    <dd class="col-sm-9 fw-bold">$@(Model.Items?.Sum(i => i.TotalCost).ToString("N2").Replace('.', ',') ?? "0,00")</dd>
</dl>
<h4>Archivos adjuntos</h4>
@if (Model.Attachments != null && Model.Attachments.Any())
{
    <ul>
        @foreach (var att in Model.Attachments)
        {
            <li>
                <a href="/uploads/@att.FilePath" target="_blank">@att.FileName</a> <span class="text-muted">(@att.UploadedAt.ToString("dd/MM/yyyy HH:mm"))</span>
            </li>
        }
    </ul>
}
else
{
    <span class="text-muted">(Sin archivos adjuntos)</span>
}

<h4>Historial de cambios</h4>
@if (ViewBag.AuditLogs != null && ((List<BuildertrendMVC.Models.AuditLog>)ViewBag.AuditLogs).Any())
{
    <table class="table table-bordered table-sm">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Usuario</th>
                <th>Acción</th>
                <th>Cambios</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var log in (List<BuildertrendMVC.Models.AuditLog>)ViewBag.AuditLogs)
        {
            <tr>
                <td>@log.Timestamp.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@log.UserName</td>
                <td>@log.Action</td>
                <td>@log.Changes</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <span class="text-muted">(Sin historial de cambios)</span>
}

<h4>Comentarios internos</h4>
@if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Empleado")))
{
    <form asp-action="AddComment" method="post" class="mb-3">
        <input type="hidden" name="quoteId" value="@Model.Id" />
        <div class="mb-2">
            <textarea name="comment" class="form-control" rows="2" maxlength="500" placeholder="Agrega un comentario interno..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Agregar comentario</button>
    </form>
}
@if (ViewBag.QuoteComments != null && ((List<BuildertrendMVC.Models.QuoteComment>)ViewBag.QuoteComments).Any())
{
    <ul class="list-group mb-3">
    @foreach (var c in (List<BuildertrendMVC.Models.QuoteComment>)ViewBag.QuoteComments)
    {
        <li class="list-group-item">
            <div class="d-flex justify-content-between">
                <span><strong>@c.UserName</strong> <span class="text-muted">@c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></span>
            </div>
            <div>@c.Comment</div>
        </li>
    }
    </ul>
}
else
{
    <span class="text-muted">(Sin comentarios internos)</span>
}

<h4>Eventos de calendario</h4>
@if (ViewBag.QuoteEvents != null && ((List<BuildertrendMVC.Models.QuoteEvent>)ViewBag.QuoteEvents).Any())
{
    <table class="table table-bordered table-sm">
        <thead>
            <tr>
                <th>Título</th>
                <th>Fecha</th>
                <th>Descripción</th>
                <th>Color</th>
                @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Empleado")))
                {
                    <th>Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
        @foreach (var ev in (List<BuildertrendMVC.Models.QuoteEvent>)ViewBag.QuoteEvents)
        {
            <tr>
                <td>@ev.Title</td>
                <td>@ev.Date.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@ev.Description</td>
                <td><span style="display:inline-block;width:18px;height:18px;background:@ev.Color;border-radius:4px;border:1px solid #ccc;"></span></td>
                @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Empleado")))
                {
                    <td>
                        <form asp-action="DeleteEvent" method="post" style="display:inline">
                            <input type="hidden" name="eventId" value="@ev.Id" />
                            <input type="hidden" name="quoteId" value="@Model.Id" />
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Eliminar evento?')">Eliminar</button>
                        </form>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <span class="text-muted">(Sin eventos de calendario)</span>
}

@if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Empleado")))
{
    <h5 class="mt-3">Agregar evento</h5>
    <form asp-action="AddEvent" method="post" class="row g-2 align-items-end">
        <input type="hidden" name="quoteId" value="@Model.Id" />
        <div class="col-md-3">
            <label class="form-label">Título</label>
            <input type="text" name="title" class="form-control" maxlength="100" required />
        </div>
        <div class="col-md-3">
            <label class="form-label">Fecha y hora</label>
            <input type="datetime-local" name="date" class="form-control" required />
        </div>
        <div class="col-md-3">
            <label class="form-label">Descripción</label>
            <input type="text" name="description" class="form-control" maxlength="200" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Color</label>
            <input type="color" name="color" class="form-control form-control-color" value="#007bff" />
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-success">Agregar</button>
        </div>
    </form>
}

<h4>Partidas</h4>
@if (Model.Items != null && Model.Items.Any())
{
    <table class="table table-bordered table-sm">
        <thead>
            <tr>
                <th>Cost Code</th>
                <th>Title</th>
                <th>Description</th>
                <th>Qty</th>
                <th>Unit Cost</th>
                <th>Margin</th>
                <th>Customer Cost</th>
                <th>Total Cost</th>
                <th>Cost Type</th>
                <th>Markup %</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.CostCode</td>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>@item.Qty</td>
                <td>$@item.UnitCost.ToString("N2").Replace('.', ',')</td>
                <td>@item.Margin.ToString("N2").Replace('.', ',')</td>
                <td>$@item.CustomerCost.ToString("N2").Replace('.', ',')</td>
                <td class="fw-bold">$@item.TotalCost.ToString("N2").Replace('.', ',')</td>
                <td>@item.CostType</td>
                <td>@item.MarkupPercentage.ToString("N2") %</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <span class="text-muted">(Sin partidas)</span>
}
<a class="btn btn-secondary mt-3" href="/Quote">Regresar</a>