@model BuildertrendMVC.ViewModels.QuoteCreateViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Nueva Cotización";
}
<h2>Nueva Cotización</h2>
<div class="mb-3">
    <label class="form-label">Folio (se generará al guardar)</label>
    <input class="form-control" value="(se asigna automáticamente)" readonly />
</div>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<div>
    <h5>Debug ModelState:</h5>
    @if (!ViewData.ModelState.IsValid)
    {
        <ul>
        @foreach (var key in ViewData.ModelState.Keys)
        {
            var state = ViewData.ModelState[key];
            if (state.Errors.Count > 0)
            {
                <li><b>@key</b>: @string.Join(", ", state.Errors.Select(e => e.ErrorMessage))</li>
            }
        }
        </ul>
    }
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label asp-for="ClientId" class="form-label">Cliente</label>
        <select asp-for="ClientId" class="form-select">
            <option value="">Selecciona un cliente</option>
            @if (Model.ClientesDisponibles != null)
            {
                foreach (var c in Model.ClientesDisponibles)
                {
                    <option value="@c.Id" selected="@(Model.ClientId == c.Id ? "selected" : null)">@c.Nombre (@c.Empresa)</option>
                }
            }
        </select>
        <span asp-validation-for="ClientId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Sales Tax %</label>
        <select asp-for="SalesTax" class="form-select" id="SalesTax">
            <option value="">Selecciona una opción</option>
            <option value="0.07">7,00</option>
            <option value="0.0725">7,25</option>
            <option value="0.0775">7,75</option>
        </select>
        <span asp-validation-for="SalesTax" class="text-danger"></span>
        <small class="form-text text-muted">Selecciona el porcentaje de impuesto a aplicar.</small>
    </div>



    <h4>Archivos adjuntos</h4>
    <div class="mb-3">
        <label class="form-label">Selecciona archivos para adjuntar (PDF, imágenes, planos, etc.)</label>
        <input type="file" name="Attachments" class="form-control" multiple accept=".pdf,image/*,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" />
        <small class="form-text text-muted">Puedes adjuntar varios archivos.</small>
    </div>

    <h4>Partidas de la Cotización</h4>
    <table class="table table-bordered" id="itemsTable">
        <thead>
            <tr>
                <th>@Localizer["CostCode"]</th>
                <th>@Localizer["Title"]</th>
                <th>@Localizer["Description"]</th>
                <th>@Localizer["Qty"]</th>
                <th>@Localizer["UnitCost"]</th>
                <th>@Localizer["MarginPercent"]</th>
                <th>@Localizer["CustomerCost"]</th>
                <th>@Localizer["TotalCost"]</th>
                <th>@Localizer["CostType"]</th>
                <th>@Localizer["MarkupPercent"]</th>
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>
                        <select name="Items[@i].CostCode" class="form-select">
                            @if (Model.Items[i].CostCode == null || Model.Items[i].CostCode == "") {
                                <option value="" selected>Selecciona</option>
                            } else {
                                <option value="">Selecciona</option>
                            }
                            @if (Model.Items[i].CostCode == "Andersen") {
                                <option value="Andersen" selected>Andersen</option>
                            } else {
                                <option value="Andersen">Andersen</option>
                            }
                            @if (Model.Items[i].CostCode == "Awake") {
                                <option value="Awake" selected>Awake</option>
                            } else {
                                <option value="Awake">Awake</option>
                            }
                            @if (Model.Items[i].CostCode == "Trim") {
                                <option value="Trim" selected>Trim</option>
                            } else {
                                <option value="Trim">Trim</option>
                            }
                            @if (Model.Items[i].CostCode == "Otro") {
                                <option value="Otro" selected>Otro</option>
                            } else {
                                <option value="Otro">Otro</option>
                            }
                        </select>
                    </td>
                    <td><input name="Items[@i].Title" class="form-control" value="@Model.Items[i].Title" /></td>
                    <td><input name="Items[@i].Description" class="form-control" value="@Model.Items[i].Description" /></td>
                    <td><input name="Items[@i].Qty" class="form-control qty-input" type="number" step="0.01" value="@Model.Items[i].Qty" /></td>
                    <td><input name="Items[@i].UnitCost" class="form-control unitcost-input" type="number" step="0.01" value="@Model.Items[i].UnitCost" /></td>
                    <td><input name="Items[@i].Margin" class="form-control margin-output" type="number" step="0.01" min="0" max="100" value="@((Model.Items[i].Margin > 0 ? (Model.Items[i].Margin * 100) : 35).ToString(System.Globalization.CultureInfo.InvariantCulture))" /></td>
                    <td><input class="form-control customercost-output" type="text" value="@GetCurrencySymbol(ViewBag.Currency)@FormatAmount(Model.Items[i].CustomerCost, ViewBag.Currency, ViewBag.Language)" readonly /></td>
                    <td><input class="form-control totalcost-output" type="text" value="@GetCurrencySymbol(ViewBag.Currency)@FormatAmount(Model.Items[i].TotalCost, ViewBag.Currency, ViewBag.Language)" readonly /></td>
                    <td>
                        <select name="Items[@i].CostType" class="form-select costtype-input">
                            @{
                                var val = Model.Items[i].CostType ?? "";
                            }
                            <option value="" selected="@(val == "" ? "selected" : null)">Selecciona</option>
                            <option value="Material" selected="@(val == "Material" ? "selected" : null)">Material</option>
                            <option value="Labor" selected="@(val == "Labor" ? "selected" : null)">Labor</option>
                            <option value="Other" selected="@(val == "Other" ? "selected" : null)">Other</option>
                        </select>
                    </td>
                    <td><input class="form-control markup-output" type="text" value="@Model.Items[i].MarkupPercentage.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-MX"))" readonly /></td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="alert alert-info mt-3" id="salesTaxAmountSummary">
        <strong>Sales Tax Amount estimado:</strong> <span id="salesTaxAmountValue">@GetCurrencySymbol(ViewBag.Currency)0.00</span>
    </div>
    @functions {
        public static string GetCurrencySymbol(string currency)
        {
            return currency switch
            {
                "USD" => "$",
                "EUR" => "€",
                "MXN" => "$MXN ",
                "CLP" => "$CLP ",
                "ARS" => "$ARS ",
                _ => "$"
            };
        }
        public static string FormatAmount(decimal amount, string currency, string language)
        {
            var culture = (currency, language) switch
            {
                ("USD", "en") => "en-US",
                ("USD", _) => "es-MX",
                ("EUR", _) => "es-ES",
                ("MXN", _) => "es-MX",
                ("CLP", _) => "es-CL",
                ("ARS", _) => "es-AR",
                _ => "es-MX"
            };
            return amount.ToString("N2", new System.Globalization.CultureInfo(culture));
        }
    }
    <button type="button" class="btn btn-primary" onclick="addRow()">Agregar partida</button>
    <br /><br />
    <button type="submit" class="btn btn-success">Guardar</button>
    <a class="btn btn-secondary" href="/Quote">Cancelar</a>
</form>



@section Scripts {
    <script src="~/js/quote-calc.js" asp-append-version="true"></script>
}
