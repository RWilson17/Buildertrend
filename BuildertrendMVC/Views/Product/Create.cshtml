@model BuildertrendMVC.Models.Product
@{
    ViewData["Title"] = "Agregar Producto";
}
<h2>Agregar Producto (Ventana/Puerta)</h2>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Tipo</label>
        <select asp-for="Type" class="form-control">
            <option>Ventana</option>
            <option>Puerta</option>
        </select>
    </div>
    <div class="form-group">
        <label>Modelo</label>
        <input asp-for="Model" class="form-control" />
    </div>
    <div class="form-group">
        <label>Material</label>
        <input asp-for="Material" class="form-control" />
    </div>
    <div class="form-group">
        <label>Color</label>
        <input asp-for="Color" class="form-control" />
    </div>
    <div class="form-group">
        <label>Ancho</label>
        <input asp-for="Width" class="form-control" />
    </div>
    <div class="form-group">
        <label>Alto</label>
        <input asp-for="Height" class="form-control" />
    </div>
    <div class="form-group">
        <label>Cantidad</label>
        <input asp-for="Quantity" class="form-control" />
    </div>
    <div class="form-group">
        <label>Costo Unitario</label>
        <input asp-for="UnitCost" class="form-control" />
    </div>
    <div class="form-group">
        <label>Costo Total</label>
        <input asp-for="TotalCost" class="form-control" />
    </div>
    <div class="form-group">
        <label>Descripción</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a class="btn btn-secondary" href="/Product">Cancelar</a>
</form>
