@model IEnumerable<BuildertrendMVC.Models.AuditLog>
@{
    ViewData["Title"] = "Historial de Auditoría";
}
<h2>Historial de Auditoría</h2>
<table class="table table-bordered table-sm">
    <thead>
        <tr>
            <th>Fecha/Hora</th>
            <th>Usuario</th>
            <th>Entidad</th>
            <th>ID</th>
            <th>Acción</th>
            <th>Cambios</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.Timestamp.ToString("g")</td>
                <td>@log.UserName</td>
                <td>@log.EntityName</td>
                <td>@log.EntityId</td>
                <td>@log.Action</td>
                <td>@log.Changes</td>
            </tr>
        }
    </tbody>
</table>
